# Copy this file to .env.compose and replace both placeholder secrets.
POSTGRES_DB=data_agent
POSTGRES_USER=data_agent
POSTGRES_HOST_PORT=5445
# Use a long URL-safe value because this password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-database-password

# Production authentication requires at least one key with 32 characters.
API_KEYS=replace-with-a-random-api-key-at-least-32-characters-long
API_HOST_PORT=8015
API_WORKERS=1
API_DOCS_ENABLED=true
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60
API_MAX_CONCURRENT_REQUESTS=20
API_GRACEFUL_SHUTDOWN_SECONDS=30
API_READINESS_DATABASE_ENABLED=true
API_READINESS_TIMEOUT_SECONDS=3

LLM_PROVIDER=openai
LLM_MODEL_LOW=
LLM_MODEL_MEDIUM=
LLM_MODEL_HIGH=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_JSON_LOGS=true
