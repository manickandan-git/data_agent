OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supported profiles: development, test, staging, production.
# Optional .env.<profile> values override this base file.
APP_ENVIRONMENT=development

# Only the selected provider's key is required. Supported: openai, anthropic.
LLM_PROVIDER=openai
# Empty model settings preserve the existing OpenAI defaults.
# For another provider, set each model to an ID supported by that provider.   
# For anthropic low- laude-haiku-4-5-20251001, medium -claude-sonnet-5,high- claude-opus-5
LLM_MODEL_LOW=
LLM_MODEL_MEDIUM=
LLM_MODEL_HIGH=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
# GPT-5.6 uses reasoning instead of temperature; older overrides retain temperature.
OPENAI_REASONING_EFFORT=low
# Optional OpenAI-compatible endpoint; do not use untrusted endpoints with real keys.
OPENAI_BASE_URL=
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_JSON_LOGS=true
# OpenTelemetry is opt-in. The endpoint is an OTLP HTTP /v1/traces endpoint.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=data-agent
OTEL_EXPORTER_ENDPOINT=
OTEL_EXPORT_TIMEOUT_SECONDS=10
OTEL_TRACE_SAMPLE_RATIO=1
OTEL_EXCLUDED_URLS=/health
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
# Optional: API_DOCS_ENABLED defaults to false in production and true otherwise.
API_MAX_REQUEST_BYTES=16384

#postgresql database url
DATABASE_URL=
DATABASE_SCHEMA=public
SQL_ROW_LIMIT=10
SQL_TIMEOUT_SECONDS=30
SQL_CATEGORICAL_COLUMNS={"payments":["payment_method","payment_status"],"ratings":["rating"],"rides":["status","cancellation_reason"],"users":["user_type","city","province","is_active"],"vehicles":["make","model","color","is_active"]}
SQL_CATEGORICAL_VALUE_LIMIT=50

# API extraction: retries use capped exponential backoff.
ETL_TIMEOUT_SECONDS=30
ETL_MAX_RETRIES=2
ETL_MAX_PAGES=20
ETL_MAX_ROWS=100000
# Optional bearer authentication, restricted to this exact HTTPS origin.
ETL_AUTH_ORIGIN=
ETL_BEARER_TOKEN=
